# Round trip CAD -> QIF (QIF_Writer) -> PRC (QIF_Reader): the QIF must be read back by QIF_Reader with the same number of
# faces (unless QIF_Writer had to split periodic faces) and the same exact area and volume (relative TOL).
# Usage: cmake -DWRITER=<QIF_Writer> -DREADER=<QIF_Reader> -DIN=<cad file> -DQIF=<out.qif> -DPRC=<out.prc>
#              [-DTOL=1e-4] [-DEXTRA=<QIF_Writer option>] -P roundtrip.cmake
if(NOT TOL)
    set(TOL 1e-4)
endif()
set(wargs "${IN}" "${QIF}" --force --quiet)
if(EXTRA)
    list(APPEND wargs ${EXTRA})
endif()
execute_process(COMMAND "${WRITER}" ${wargs} OUTPUT_VARIABLE wout ERROR_VARIABLE werr RESULT_VARIABLE wrc)
if(NOT wrc EQUAL 0 OR NOT wout MATCHES "Check: OK")
    message(FATAL_ERROR "QIF_Writer exited with ${wrc}\n${wout}\n${werr}")
endif()
execute_process(COMMAND "${READER}" "${QIF}" "${PRC}" --force --quiet OUTPUT_VARIABLE rout ERROR_VARIABLE rerr RESULT_VARIABLE rrc)
if(NOT rrc EQUAL 0)
    message(FATAL_ERROR "QIF_Reader exited with ${rrc}\n${rout}\n${rerr}\n--- QIF_Writer:\n${wout}")
endif()

set(num "[-+0-9.eE]+")
if(NOT wout MATCHES "Source model: B-reps ([0-9]+), faces ([0-9]+), area (${num}) mm2, volume (${num}) mm3")
    message(FATAL_ERROR "no source properties in QIF_Writer output\n${wout}")
endif()
set(sfaces ${CMAKE_MATCH_2})
set(sarea ${CMAKE_MATCH_3})
set(svol ${CMAKE_MATCH_4})
if(NOT rout MATCHES "Re-imported PRC: +B-reps ([0-9]+), faces ([0-9]+), area (${num}) mm2, volume (${num}) mm3")
    message(FATAL_ERROR "no re-imported properties in QIF_Reader output\n${rout}")
endif()
set(rfaces ${CMAKE_MATCH_2})
set(rarea ${CMAKE_MATCH_3})
set(rvol ${CMAKE_MATCH_4})

# decimal text (as printed with %.6g) -> integer value x 1e3, for an integer relative comparison
function(to_milli text out)
    if(NOT text MATCHES "^(-?)([0-9]+)(\\.([0-9]+))?([eE]([-+]?)([0-9]+))?$")
        message(FATAL_ERROR "cannot parse number '${text}'")
    endif()
    set(sign "${CMAKE_MATCH_1}")
    set(digits "${CMAKE_MATCH_2}${CMAKE_MATCH_4}")
    string(LENGTH "${CMAKE_MATCH_4}" frac)
    set(e 0)
    if(CMAKE_MATCH_7)
        set(e "${CMAKE_MATCH_6}${CMAKE_MATCH_7}")
    endif()
    math(EXPR shift "${e} - ${frac} + 3")
    string(REGEX REPLACE "^0+([0-9])" "\\1" digits "${digits}")
    if(shift GREATER_EQUAL 0)
        while(shift GREATER 0)
            string(APPEND digits "0")
            math(EXPR shift "${shift} - 1")
        endwhile()
    else()
        math(EXPR cut "0 - ${shift}")
        string(LENGTH "${digits}" len)
        if(cut GREATER_EQUAL len)
            set(digits 0)
        else()
            math(EXPR keep "${len} - ${cut}")
            string(SUBSTRING "${digits}" 0 ${keep} digits)
        endif()
    endif()
    set(${out} "${sign}${digits}" PARENT_SCOPE)
endfunction()

function(check_close what a b)
    to_milli("${a}" ia)
    to_milli("${b}" ib)
    math(EXPR d "${ia} - ${ib}")
    if(d LESS 0)
        math(EXPR d "0 - ${d}")
    endif()
    set(m ${ia})
    if(m LESS 0)
        math(EXPR m "0 - ${m}")
    endif()
    # |a-b| <= TOL * |a| + 2 (milli units), TOL given as 1e-N
    string(REGEX REPLACE "^1e-([0-9]+)$" "\\1" n "${TOL}")
    set(scaled ${m})
    while(n GREATER 0)
        math(EXPR scaled "${scaled} / 10")
        math(EXPR n "${n} - 1")
    endwhile()
    math(EXPR lim "${scaled} + 2")
    if(d GREATER lim)
        message(FATAL_ERROR "${what} differs: source ${a}, after QIF round trip ${b}")
    endif()
endfunction()

if(NOT wout MATCHES "split")
    if(NOT sfaces EQUAL rfaces)
        message(FATAL_ERROR "faces differ: source ${sfaces}, after QIF round trip ${rfaces}\n${wout}\n${rout}")
    endif()
endif()
check_close(area "${sarea}" "${rarea}")
check_close(volume "${svol}" "${rvol}")
message(STATUS "round trip OK: faces ${sfaces} -> ${rfaces}, area ${sarea} -> ${rarea} mm2, volume ${svol} -> ${rvol} mm3")
