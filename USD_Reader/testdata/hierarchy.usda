#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 0.01
)

def Xform "World" (
    kind = "assembly"
)
{
    def Xform "Assembly" (
        kind = "component"
    )
    {
        double3 xformOp:translate = (0, 5, 0)
        float xformOp:rotateZ = 90
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        custom string partNumber = "PN-42"
        custom string userProperties:supplier = "ACME"

        # Two quads and a triangle; the triangle is a hole. Left-handed, flat: normals are computed and flipped.
        def Mesh "Panel"
        {
            point3f[] points = [(0, 0, 0), (2, 0, 0), (2, 1, 0), (0, 1, 0), (3, 0, 0), (4, 0.5, 0), (3, 1, 0), (5, 0, 0), (6, 0, 0), (6, 1, 0)]
            int[] faceVertexCounts = [4, 4, 3]
            int[] faceVertexIndices = [0, 1, 2, 3, 1, 4, 6, 2, 7, 8, 9]
            int[] holeIndices = [2]
            uniform token orientation = "leftHanded"
            uniform token subdivisionScheme = "none"
            color3f[] primvars:displayColor = [(1, 0, 0), (0, 0, 1), (0, 1, 0)] (
                interpolation = "uniform"
            )
        }

        # Per-vertex colours, constant opacity, authored face-varying normals.
        def Mesh "Dots"
        {
            point3f[] points = [(0, 0, 1), (1, 0, 1), (0, 1, 1)]
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            normal3f[] primvars:normals = [(0, 0, 1), (0, 0, 1), (0, 0, 1)] (
                interpolation = "faceVarying"
            )
            color3f[] primvars:displayColor = [(1, 0, 0), (0, 1, 0), (0, 0, 1)] (
                interpolation = "vertex"
            )
            float[] primvars:displayOpacity = [0.5] (
                interpolation = "constant"
            )
        }

        # resetXformStack: placed in world space whatever its parents do.
        def Xform "Detached"
        {
            double3 xformOp:translate = (0, 0, 7)
            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate"]

            def Cube "Marker"
            {
                double size = 1
            }
        }
    }

    def Cube "Hidden"
    {
        token visibility = "invisible"
        double size = 100
    }

    def Cube "Guide"
    {
        uniform token purpose = "guide"
        double size = 100
    }

    def Cube "Proxy"
    {
        uniform token purpose = "proxy"
        double size = 100
    }

    def BasisCurves "Wire"
    {
        uniform token type = "linear"
        int[] curveVertexCounts = [2]
        point3f[] points = [(0, 0, 0), (1, 1, 1)]
    }
}
