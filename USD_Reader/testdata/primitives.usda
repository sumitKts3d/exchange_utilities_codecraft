#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 1
)

def Xform "World"
{
    def Cube "Cube"
    {
        double size = 2
    }

    def Sphere "Sphere"
    {
        double radius = 1
        double3 xformOp:translate = (5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cylinder"
    {
        double radius = 1
        double height = 4
        uniform token axis = "X"
        double3 xformOp:translate = (10, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "Cone"
    {
        double radius = 2
        double height = 2
        uniform token axis = "Y"
        double3 xformOp:translate = (15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "Capsule"
    {
        double radius = 0.5
        double height = 2
        uniform token axis = "Z"
        double3 xformOp:translate = (20, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Plane "Plane"
    {
        double width = 4
        double length = 2
        uniform token axis = "Z"
        double3 xformOp:translate = (25, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder_1 "TaperedCylinder"
    {
        double radiusTop = 0.5
        double radiusBottom = 1
        double height = 2
        uniform token axis = "Z"
        double3 xformOp:translate = (30, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
