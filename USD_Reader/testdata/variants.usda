#usda 1.0
(
    defaultPrim = "Bolt"
    upAxis = "Z"
    metersPerUnit = 1
)

def Xform "Bolt" (
    variants = {
        string size = "small"
    }
    prepend variantSets = "size"
)
{
    variantSet "size" = {
        "small" {
            def Cube "Body"
            {
                double size = 1
            }
        }
        "large" {
            def Cube "Body"
            {
                double size = 4
            }
        }
    }
}
